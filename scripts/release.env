# Minimum macOS for this release line. build-app.sh puts it in Info.plist;
# release.sh puts it in the Homebrew cask. Raise them here, and the platform in
# Package.swift, together.
MIN_MACOS=27.0
MIN_MACOS_NAME=golden_gate

# Signing identity for releases. Public: it is embedded in every signed binary.
DEVELOPER_ID="Developer ID Application: Nathan Colosimo (B8R99NL6HM)"
